{
  "name": "suvanza-catalogo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:migrate": "node --env-file=.env --import tsx scripts/migrate.ts",
    "db:migrate:odoo-products": "node --env-file=.env --import tsx scripts/migrate-odoo-products.ts",
    "db:check:odoo-products": "node --env-file=.env --import tsx scripts/migrate-odoo-products.ts --check",
    "test:odoo-products": "node --import ./tests/server-only-register.mjs --import tsx --test tests/odoo-products.test.ts",
    "db:reset": "node --env-file=.env.local --import tsx scripts/migrate.ts -- --wipe",
    "auth:hash": "node --env-file=.env.local --import tsx scripts/hash-password.ts",
    "db:migrate:odoo-exports": "node --env-file=.env --import tsx scripts/migrate-odoo-exports.ts",
    "test:odoo-exports": "node --import ./tests/server-only-register.mjs --import tsx --test tests/odoo-exports.test.ts",
    "test:odoo-customer-review": "node --import ./tests/server-only-register.mjs --import tsx --test tests/odoo-customer-review.test.ts",
    "db:migrate:order-deletion": "node --env-file=.env --import tsx scripts/migrate-order-deletion.ts",
    "test:order-deletion": "node --import ./tests/deletion-register.mjs --import tsx --test tests/order-deletion.test.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.17.2",
    "@supabase/supabase-js": "^2.55.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.9.0",
    "gsap": "^3.15.0",
    "jose": "^6.2.2",
    "lucide-react": "^0.539.0",
    "next": "16.2.4",
    "next-cloudinary": "^6.17.5",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "swiper": "^11.2.10",
    "xmlrpc": "^1.3.2",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
